{
  "name": "zonix-http",
  "version": "0.2.0",
  "description": "Zero-dependency, Express-compatible HTTP framework for Node.js.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swapnil155/zonix-http.git"
  },
  "bugs": {
    "url": "https://github.com/Swapnil155/zonix-http/issues"
  },
  "homepage": "https://github.com/Swapnil155/zonix-http#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup lib/index.ts --format esm --dts --sourcemap --clean",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "bench": "npm run build && node bench/run.mjs",
    "format": "prettier --write \"{lib,test,bench,examples,scripts}/**/*.{ts,js,mjs}\" \"*.{json,md}\" \".github/**/*.yml\"",
    "example": "tsx examples/basic.ts",
    "profile": "npm run build && node bench/profile.mjs",
    "micro": "tsx bench/micro.ts",
    "micro:serializer": "tsx bench/serializer.ts",
    "bench:scaling": "node bench/scaling.mjs",
    "format:check": "prettier --check \"{lib,test,bench,examples,scripts}/**/*.{ts,js,mjs}\" \"*.{json,md}\" \".github/**/*.yml\"",
    "coverage": "node scripts/run-tests.mjs --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "http",
    "framework",
    "router",
    "express",
    "express-compatible",
    "zero-dependency",
    "middleware"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "body-parser": "1.20.6",
    "compression": "1.8.1",
    "content-disposition": "^0.5.4",
    "cookie-parser": "1.4.7",
    "cookie-signature": "^1.0.7",
    "cpeak": "2.9.2",
    "etag": "1.8.1",
    "express": "^4.21.2",
    "fastify": "5.12.1",
    "find-my-way": "9.8.0",
    "fresh": "0.5.2",
    "negotiator": "0.6.3",
    "prettier": "^3.4.2",
    "qs": "6.15.3",
    "range-parser": "1.2.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "type-is": "1.6.18",
    "typescript": "^5.7.2"
  }
}
